# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# BODS (Bus Open Data Service) - https://data.bus-data.dft.gov.uk
BODS_API_KEY=your-bods-api-key

# OpenTripPlanner (optional - falls back to built-in router)
OTP_URL=http://localhost:8080

# Google Maps (optional - inline Street View photos at change points)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Cornwall GTFS dataset IDs (Go South West / Go Cornwall Bus)
BODS_DATASET_ID=23002
